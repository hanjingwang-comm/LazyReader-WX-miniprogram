{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["miniprogram/**/*.ts", "miniprogram/**/*.d.ts"],
  "exclude": ["cloudfunctions", "node_modules"]
}
