.import-page { min-height: 100vh; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); color: #1f2421; background: #f4f3ed; }
button::after { border: 0; }
.import-header { display: flex; gap: 18rpx; align-items: center; padding-right: 28rpx; padding-bottom: 24rpx; padding-left: 20rpx; background: #f7efd1; border-bottom: 2rpx solid #d5ceb7; }
.back-button { flex: 0 0 64rpx; width: 64rpx; margin: 0; padding: 0; color: #315d96; background: transparent; border: 0; font-size: 56rpx; line-height: 1; }
.import-header > view { flex: 1; min-width: 0; }
.header-title { display: block; font-family: Georgia, "Songti SC", serif; font-size: 36rpx; font-weight: 700; }
.header-note { display: block; margin-top: 3rpx; color: #6f756f; font-size: 21rpx; }
.tab-switch { display: flex; gap: 12rpx; padding: 30rpx 28rpx 12rpx; }
.tab-switch button { width: auto; min-width: 112rpx; height: 66rpx; margin: 0; padding: 0 24rpx; color: #6e756f; background: transparent; border: 2rpx solid #b9bfba; border-radius: 8rpx; font-size: 27rpx; font-weight: 700; line-height: 62rpx; }
.tab-switch button.is-active { color: #fff; background: #315f4b; border-color: #315f4b; }
.create-sheet, .attachment-sheet { position: relative; margin: 28rpx; padding: 54rpx 42rpx 44rpx; background: #fffdfa; border: 2rpx solid #cfd2cc; box-shadow: 12rpx 14rpx 0 #dbe4df; }
.create-sheet::before { position: absolute; top: -15rpx; left: 50%; width: 150rpx; height: 34rpx; background: rgba(226, 192, 78, .46); content: ""; transform: translateX(-50%) rotate(-1deg); }
.sheet-kicker { color: #315d96; font-family: "Courier New", monospace; font-size: 20rpx; letter-spacing: 1rpx; }
.sheet-title { display: block; margin-top: 20rpx; font-family: Georgia, "Songti SC", serif; font-size: 43rpx; font-weight: 700; }
.sheet-description { display: block; margin-top: 16rpx; color: #626b65; font-size: 25rpx; line-height: 1.7; }
.title-input { height: 96rpx; margin-top: 36rpx; padding: 0 4rpx; color: #242a26; border-bottom: 4rpx solid #315f4b; font-family: Georgia, "Songti SC", serif; font-size: 34rpx; }
.title-placeholder { color: #9b9f9b; }
.folder-choice { display: flex; gap: 16rpx; align-items: center; margin-top: 36rpx; padding: 20rpx; background: #f3f5f1; border: 2rpx solid #dde1dc; }
.folder-choice.compact { margin-top: 28rpx; }
.folder-choice image { width: 38rpx; height: 38rpx; }
.folder-choice view { flex: 1; }
.folder-choice view > text:first-child { display: block; color: #78807b; font-size: 20rpx; }
.folder-value { display: block; margin-top: 2rpx; color: #313833; font-size: 25rpx; font-weight: 700; }
.choice-arrow { color: #315d96; font-size: 44rpx; }
.primary-action { height: 84rpx; margin-top: 40rpx; color: #fff; background: #315f4b; border: 0; border-radius: 8rpx; font-size: 29rpx; font-weight: 700; line-height: 84rpx; }
.primary-action[disabled] { opacity: .55; }
.source-actions { display: grid; gap: 16rpx; margin-top: 30rpx; }
.source-actions button { display: flex; gap: 18rpx; align-items: center; min-height: 112rpx; margin: 0; padding: 18rpx 20rpx; color: #242a26; background: #f6f7f3; border: 2rpx solid #d6dad4; border-radius: 8rpx; text-align: left; }
.source-actions image { width: 48rpx; height: 48rpx; }
.source-actions view { flex: 1; }
.source-actions view text { display: block; font-size: 27rpx; font-weight: 700; }
.source-actions view text:last-child { margin-top: 6rpx; color: #777f79; font-size: 21rpx; font-weight: 400; }
.source-actions > button > text { color: #315d96; font-size: 36rpx; }
.pending-list { margin-top: 34rpx; }
.pending-heading { display: flex; justify-content: space-between; padding-bottom: 14rpx; color: #333934; border-bottom: 2rpx solid #d4d7d2; font-size: 24rpx; font-weight: 700; }
.pending-heading text:last-child { color: #78807b; font-weight: 400; }
.pending-row { display: flex; gap: 14rpx; align-items: center; padding: 18rpx 0; border-bottom: 2rpx solid #e0e2de; }
.pending-row > image { width: 40rpx; height: 40rpx; }
.pending-row > view { flex: 1; min-width: 0; }
.pending-row view text { display: block; overflow: hidden; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.pending-row view text:last-child { margin-top: 5rpx; color: #7f857f; font-size: 20rpx; }
.pending-row button { width: 56rpx; margin: 0; padding: 0; color: #7b807c; background: transparent; border: 0; font-size: 34rpx; }
.pending-empty { margin-top: 34rpx; padding: 32rpx; color: #878d88; background: #f4f5f2; border: 2rpx solid #dfe1dd; font-size: 23rpx; text-align: center; }
