<view class="import-page">
  <view class="import-header" style="padding-top: {{contentTop}}px">
    <button size="mini" class="back-button" bindtap="goBack">‹</button>
    <view><text class="header-title">添加到 LazyReader</text><text class="header-note">把想法与材料放进自己的档案</text></view>
  </view>

  <view class="tab-switch">
    <button size="mini" class="{{tab === 'article' ? 'is-active' : ''}}" data-tab="article" bindtap="setTab">文章</button>
    <button size="mini" class="{{tab === 'attachment' ? 'is-active' : ''}}" data-tab="attachment" bindtap="setTab">附件</button>
  </view>

  <view wx:if="{{tab === 'article'}}" class="create-sheet">
    <view class="sheet-kicker">NEW ENTRY · 001</view>
    <input class="title-input" value="{{title}}" bindinput="onTitleInput" placeholder="你在想什么？" placeholder-class="title-placeholder" maxlength="100" focus />
    <view class="folder-choice" bindtap="chooseFolder">
      <image src="/assets/icons/folder.svg" mode="aspectFit" />
      <view><text>保存到</text><text class="folder-value">{{folderName}}</text></view>
      <text class="choice-arrow">›</text>
    </view>
    <button class="primary-action" bindtap="createArticle">开始写作</button>
  </view>

  <view wx:else class="attachment-sheet">
    <view class="sheet-kicker">LOCAL MATERIAL · FILES</view>
    <text class="sheet-title">选择一种材料</text>
    <text class="sheet-description">图片会在云端识别文字，原图作为隐藏源文件保存；PDF 保留原文件入口。两者都不会标记来源分类。</text>
    <view class="source-actions">
      <button bindtap="chooseImages">
        <image src="/assets/icons/image.svg" mode="aspectFit" />
        <view><text>图片与书页照片</text><text>拍摄或从相册选择，可多选</text></view>
        <text>＋</text>
      </button>
      <button bindtap="choosePdfs">
        <image src="/assets/icons/file-text.svg" mode="aspectFit" />
        <view><text>PDF 文档</text><text>从微信会话文件中选择</text></view>
        <text>＋</text>
      </button>
    </view>
    <view class="folder-choice compact" bindtap="chooseFolder">
      <image src="/assets/icons/folder.svg" mode="aspectFit" />
      <view><text>导入到</text><text class="folder-value">{{folderName}}</text></view>
      <text class="choice-arrow">›</text>
    </view>

    <view wx:if="{{pendingFiles.length}}" class="pending-list">
      <view class="pending-heading"><text>待导入文件</text><text>{{pendingFiles.length}} 项</text></view>
      <view wx:for="{{pendingFiles}}" wx:key="path" class="pending-row">
        <image src="{{item.type === 'image' ? '/assets/icons/image.svg' : '/assets/icons/file-text.svg'}}" mode="aspectFit" />
        <view><text>{{item.name}}</text><text>{{item.type === 'image' ? '图片 · 将提取文字' : 'PDF'}} · {{item.sizeLabel}}</text></view>
        <button size="mini" data-index="{{index}}" bindtap="removePending">×</button>
      </view>
      <button class="primary-action" disabled="{{importing}}" bindtap="importFiles">{{importing ? '正在导入…' : '导入到资料库'}}</button>
    </view>
    <view wx:else class="pending-empty">尚未选择文件</view>
  </view>
</view>
