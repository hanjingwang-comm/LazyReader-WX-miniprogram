.checkin-page { height: 100vh; overflow: hidden; color: #202420; background: #f2f3ef; }
button::after { border: 0; }
.checkin-scroll { height: calc(100vh - 96px - env(safe-area-inset-bottom)); }
.checkin-header { display: flex; align-items: flex-end; justify-content: space-between; padding-right: 28rpx; padding-bottom: 28rpx; padding-left: 28rpx; background: #f7f7f3; }
.page-kicker { display: block; color: #315d96; font-family: "Courier New", monospace; font-size: 19rpx; letter-spacing: 2rpx; }
.page-title { display: block; width: fit-content; margin-top: 8rpx; font-family: Georgia, "Songti SC", serif; font-size: 54rpx; font-weight: 700; }
.ink-highlight { background: linear-gradient(transparent 72%, rgba(225, 193, 79, .42) 72%); }
.page-subtitle { display: block; margin-top: 7rpx; color: #717973; font-size: 22rpx; }
.add-button { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0; padding: 0; background: #e6edf5; border: 2rpx solid #315d96; border-radius: 10rpx; }
.add-button image { width: 38rpx; height: 38rpx; }
.calendar-sheet { margin: 0 20rpx; padding: 24rpx 20rpx 28rpx; background: #fff; border: 2rpx solid #d7dad5; border-radius: 14rpx; box-shadow: 5rpx 6rpx 0 rgba(50, 72, 60, .08); }
.month-nav { display: flex; align-items: center; justify-content: space-between; padding: 0 10rpx 18rpx; border-bottom: 2rpx solid #e0e2de; }
.month-nav > text { font-family: Georgia, "Songti SC", serif; font-size: 31rpx; font-weight: 700; }
.month-nav view { display: flex; }
.month-nav button { width: 58rpx; height: 48rpx; margin: 0; padding: 0; color: #315d96; background: transparent; border: 0; font-size: 42rpx; line-height: 44rpx; }
.weekday-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.weekday-row { padding: 18rpx 0 8rpx; color: #707873; font-family: "Courier New", monospace; font-size: 20rpx; text-align: center; }
.date-cell { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 1; min-width: 0; color: #343a36; font-size: 23rpx; }
.date-cell.is-outside { color: #b7bbb8; }
.date-cell.is-selected::after { position: absolute; inset: 5rpx; border: 3rpx solid #315d96; border-radius: 50%; content: ""; }
.calendar-sticker { position: absolute; top: 5rpx; left: 5rpx; width: calc(100% - 10rpx); height: calc(100% - 10rpx); overflow: hidden; border-radius: 12rpx; opacity: .96; }
.date-cell.has-log > text:not(.log-count) { z-index: 2; display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; color: #fff; background: rgba(27, 31, 28, .63); border-radius: 50%; font-size: 17rpx; }
.log-count { position: absolute; z-index: 3; top: 1rpx; right: 1rpx; min-width: 24rpx; height: 24rpx; color: #fff; background: #d3aa36; border-radius: 12rpx; font-size: 15rpx; line-height: 24rpx; text-align: center; }
.stats-sheet { display: grid; grid-template-columns: 1fr 1fr; margin: 24rpx 20rpx 0; background: #fbfaf6; border-top: 4rpx double #aeb4ae; border-bottom: 4rpx double #aeb4ae; }
.stats-sheet > view { min-height: 156rpx; padding: 24rpx; border-right: 2rpx solid #d2d5d0; border-bottom: 2rpx solid #d2d5d0; }
.stats-sheet > view:nth-child(even) { border-right: 0; }
.stats-sheet > view:nth-child(n+3) { border-bottom: 0; }
.stats-sheet text { display: block; color: #69716c; font-size: 20rpx; }
.stats-sheet .stat-number { display: inline; margin-right: 8rpx; color: #252a26; font-family: Georgia, serif; font-size: 50rpx; line-height: 1.45; }
.goal-stat .stat-number { color: #315d96; }
.goal-line { height: 5rpx; margin-top: 10rpx; overflow: hidden; background: #dfe2dd; }
.goal-line view { height: 100%; background: #315d96; }
.daily-section { margin: 32rpx 20rpx 0; }
.daily-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14rpx; border-bottom: 3rpx solid #2f3732; }
.daily-heading view text { display: block; font-family: Georgia, "Songti SC", serif; font-size: 33rpx; font-weight: 700; }
.daily-heading view text:last-child { margin-top: 2rpx; color: #858b86; font-family: "Courier New", monospace; font-size: 18rpx; font-weight: 400; }
.daily-heading button { width: 62rpx; height: 62rpx; margin: 0; padding: 0; color: #315d96; background: #e5ecf5; border: 2rpx solid #315d96; border-radius: 8rpx; font-size: 38rpx; line-height: 58rpx; }
.log-list { background: #fafaf7; }
.log-row { display: flex; gap: 16rpx; align-items: center; min-height: 116rpx; padding: 15rpx 8rpx; border-bottom: 2rpx solid #d7dad5; }
.record-sticker { flex: 0 0 auto; width: 78rpx; height: 90rpx; border: 3rpx solid #fff; border-radius: 9rpx; box-shadow: 2rpx 3rpx 0 #c9ccc7; }
.log-copy { flex: 1; min-width: 0; }
.log-copy text { display: block; overflow: hidden; color: #262c28; font-family: Georgia, "Songti SC", serif; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.log-copy text:last-child { margin-top: 8rpx; color: #747b76; font-family: inherit; font-size: 21rpx; font-weight: 400; }
.edit-mark { color: #315d96; font-size: 19rpx; }
.empty-log { padding: 54rpx 24rpx; color: #808782; text-align: center; }
.empty-log text { display: block; font-size: 23rpx; }
.empty-log button { width: auto; margin: 18rpx auto 0; padding: 8rpx 18rpx; color: #315d96; background: transparent; border: 2rpx solid #9eafc3; border-radius: 6rpx; font-size: 22rpx; }
.tab-spacer { height: 20rpx; }
.sheet-scrim { box-sizing: border-box; position: fixed; z-index: 70; inset: 0; display: flex; align-items: flex-end; background: rgba(25, 30, 27, .38); }
.log-form { box-sizing: border-box; display: flex; flex-direction: column; width: 100%; height: 100%; max-height: 100%; overflow: hidden; background: #fbfaf6; border-radius: 20rpx 20rpx 0 0; box-shadow: 0 -16rpx 50rpx rgba(0,0,0,.18); }
.form-heading { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 28rpx 20rpx; background: #f4e9bc; border-bottom: 2rpx solid #d5ca9f; }
.form-heading view text { display: block; font-family: Georgia, "Songti SC", serif; font-size: 32rpx; font-weight: 700; }
.form-heading view text:last-child { margin-top: 3rpx; color: #315d96; font-family: "Courier New", monospace; font-size: 17rpx; }
.form-heading button { width: 56rpx; margin: 0; padding: 0; color: #315d96; background: transparent; border: 0; font-size: 40rpx; }
.form-heading, .form-actions { flex: 0 0 auto; }
.form-heading > view { flex: 1; min-width: 0; }
.form-heading button { flex: 0 0 56rpx; }
.form-scroll { flex: 1; min-height: 0; height: 0; }
.form-fields { padding: 24rpx 28rpx 4rpx; }
.form-fields label { display: block; margin-bottom: 20rpx; }
.form-fields label > text, .sticker-heading > text:first-child { display: block; margin-bottom: 8rpx; color: #626a65; font-size: 20rpx; font-weight: 700; }
.form-fields input, .field-value { box-sizing: border-box; height: 70rpx; padding: 0 16rpx; color: #252b27; background: #fff; border: 2rpx solid #d8dbd6; border-radius: 6rpx; font-size: 25rpx; line-height: 66rpx; }
.field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.sticker-heading { display: flex; align-items: flex-end; justify-content: space-between; padding: 10rpx 28rpx 14rpx; }
.sticker-heading > text:last-child { color: #838a85; font-size: 18rpx; }
.sticker-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; padding: 0 28rpx 28rpx; }
.sticker-option { position: relative; aspect-ratio: .78; overflow: hidden; border: 3rpx solid transparent; border-radius: 9rpx; }
.sticker-option > image { display: block; width: 100%; height: 100%; }
.sticker-option.is-selected { border-color: #315d96; box-shadow: 0 0 0 4rpx #dfe8f3; }
.sticker-option > text { position: absolute; right: 4rpx; bottom: 4rpx; display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; color: #fff; background: #315d96; border-radius: 50%; font-size: 18rpx; }
.form-actions { display: flex; gap: 14rpx; padding: 14rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); background: #f7f7f3; border-top: 2rpx solid #d7dad5; }
.form-actions button { height: 76rpx; margin: 0; border-radius: 7rpx; font-size: 25rpx; font-weight: 700; line-height: 72rpx; }
.delete-button { width: 150rpx; color: #99463b; background: #fff; border: 2rpx solid #cfa69f; }
.save-log { flex: 1; color: #fff; background: #315f4b; border: 2rpx solid #315f4b; }
.bookshelf { padding: 0 28rpx 24rpx; }
.shelf-heading { display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; }
.shelf-heading button { margin: 0; padding: 0 12rpx; color: #315d96; background: transparent; font-size: 36rpx; }
.shelf-scroll { width: 100%; white-space: nowrap; }
.shelf-book { display: inline-block; vertical-align: top; width: 128rpx; margin: 0 16rpx 0 0; padding: 0; border-radius: 0; background: transparent; }
.shelf-book image { display: block; width: 128rpx; height: 156rpx; }
.shelf-book text { display: block; overflow: hidden; text-overflow: ellipsis; font-size: 21rpx; line-height: 34rpx; }
.shelf-empty, .new-book { color: #315d96; background: transparent; text-align: left; padding: 12rpx 0; font-size: 24rpx; }
.page-mode { display: flex; gap: 12rpx; margin-bottom: 18rpx; }
.page-mode button { flex: 1; margin: 0; padding: 0 10rpx; font-size: 24rpx; color: #626a65; background: #edf0ed; border-radius: 8rpx; }
.page-mode .active { color: #315d96; background: #dfe8f3; }
.form-cover { display: block; width: 88rpx; height: 110rpx; margin: 0 0 16rpx; }
